{
  "schema_version": "4.0",
  "capability_provider_whitelist": {
    "grounding": [
      "google",
      "alibailian"
    ],
    "ui-grounding": [
      "alibailian",
      "google",
      "google-free"
    ]
  },
  "roles": {
    "quick": {
      "system_prompt": null,
      "requires": [
        "general"
      ],
      "output_schema": "text",
      "skip_context": true,
      "preferred_models": [
        "gemini-flash-free",
        "gemini-lite-free",
        "qwen3.7-plus",
        "gemini-flash",
        "gemini-lite",
        "gemini"
      ]
    },
    "comprehensive": {
      "system_prompt": null,
      "requires": [
        "general"
      ],
      "output_schema": "text",
      "default": true,
      "system_prompt_file": "prompts/comprehensive.md",
      "preferred_models": [
        "gemini-flash-free",
        "qwen3.7-plus",
        "qwen3-vl-plus",
        "gemini-lite-free",
        "gemini",
        "gemini-flash"
      ]
    },
    "ocr": {
      "system_prompt": null,
      "requires": [
        "ocr"
      ],
      "output_schema": "text",
      "system_prompt_file": "prompts/ocr.md",
      "preferred_models": [
        "gemini-flash-free",
        "gemini-lite-free",
        "qwen3.7-plus",
        "gemini-flash",
        "gemini-lite",
        "gemini"
      ]
    },
    "code": {
      "system_prompt": null,
      "requires": [
        "general"
      ],
      "output_schema": "text",
      "system_prompt_file": "prompts/code.md",
      "preferred_models": [
        "gemini-flash-free",
        "gemini-lite-free",
        "qwen3.7-plus",
        "gemini-flash",
        "gemini-lite",
        "gemini"
      ]
    },
    "compare": {
      "system_prompt": null,
      "requires": [
        "general"
      ],
      "multi_image": true,
      "output_schema": "text",
      "system_prompt_file": "prompts/compare.md",
      "preferred_models": [
        "gemini-flash-free",
        "qwen3.7-plus",
        "qwen3-vl-plus",
        "gemini-lite-free",
        "gemini",
        "gemini-flash"
      ]
    },
    "locate": {
      "system_prompt": null,
      "requires": [
        "grounding"
      ],
      "output_schema": "bbox_list",
      "query_mode": "targeted",
      "system_prompt_file": "prompts/locate.md",
      "preferred_models": [
        "qwen3.7-plus",
        "qwen3-vl-plus",
        "gemini"
      ]
    },
    "locate-ui": {
      "system_prompt": null,
      "requires": [
        "ui-grounding"
      ],
      "output_schema": "bbox_list",
      "query_mode": "enumerate_then_filter",
      "system_prompt_file": "prompts/locate-ui.md",
      "preferred_models": [
        "gemini-flash-free",
        "qwen3.7-plus",
        "qwen3-vl-plus",
        "gemini-flash"
      ],
      "_note": "内置精简枚举prompt，role级timeout/max_tokens覆盖model默认值"
    },
    "promptify": {
      "system_prompt_file": "prompts/reverse-prompt.md",
      "requires": [
        "general"
      ],
      "output_schema": "text",
      "max_tokens": 8192,
      "preferred_models": [
        "gemini-flash-free",
        "qwen3.7-plus",
        "qwen3-vl-plus",
        "gemini-lite-free",
        "gemini",
        "gemini-flash"
      ],
      "_note": "逆向提示词工程：写轮眼式复刻，自动选MJ/DALL-E/SD格式，max_tokens=8192确保长prompt不被截断"
    }
  },
  "defaults": {
    "role": "comprehensive",
    "format": "json",
    "timeout": 60
  },
  "cache": {
    "enabled": false,
    "dir": "~/.cache/vision-engine",
    "ttl_hours": 24
  },
  "logging": {
    "enabled": true,
    "file": "~/.local/share/vision-engine/log.jsonl",
    "level": "info",
    "rotate_mb": 50,
    "rotate_keep": 3
  },
  "context": {
    "task_goal_max_chars": 120,
    "prior_context_max_items": 2
  },
  "providers": {
    "anthropic": {
      "base_url": "https://api.anthropic.com",
      "api_format": "anthropic",
      "api_key_env": "ANTHROPIC_API_KEY",
      "models": [
        {
          "name": "claude-sonnet-5",
          "capabilities": [
            "general",
            "ocr"
          ],
          "priority": 1,
          "timeout": 60,
          "max_tokens": 4096,
          "alias": "sonnet",
          "quotas": [
            {
              "metric": "requests",
              "window_seconds": 60,
              "limit": 60,
              "_note": "保守默认值，待实测"
            }
          ]
        }
      ]
    },
    "openai": {
      "base_url": "https://api.openai.com/v1",
      "api_format": "openai",
      "api_key_env": "OPENAI_API_KEY",
      "models": [
        {
          "name": "gpt-5.6-terra",
          "capabilities": [
            "general"
          ],
          "priority": 2,
          "timeout": 60,
          "max_tokens": 4096,
          "alias": "gpt",
          "quotas": [
            {
              "metric": "requests",
              "window_seconds": 60,
              "limit": 60,
              "_note": "保守默认值，待实测"
            }
          ]
        }
      ]
    },
    "google": {
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "api_format": "google",
      "api_key_env": "GOOGLE_API_KEY_TIRE1",
      "models": [
        {
          "name": "gemini-3.1-pro-preview",
          "capabilities": [
            "general",
            "ocr",
            "grounding"
          ],
          "coordinate_convention": "gemini_1000",
          "priority": 1,
          "timeout": 60,
          "max_tokens": 4096,
          "alias": "gemini",
          "_note": "付费Tier1：RPM=25 RPD=250（截图实测），最强视觉+grounding",
          "quotas": [
            {
              "metric": "requests",
              "window_seconds": 60,
              "limit": 25,
              "_note": "Tier1 RPM 截图实测"
            },
            {
              "metric": "requests",
              "window_seconds": 86400,
              "limit": 250,
              "_note": "Tier1 RPD 截图实测"
            },
            {
              "metric": "tokens",
              "window_seconds": 60,
              "limit": 2000000,
              "_note": "Tier1 TPM 截图实测"
            }
          ],
          "cooldown_seconds": 60
        },
        {
          "name": "gemini-3.6-flash",
          "capabilities": [
            "general",
            "ocr",
            "ui-grounding"
          ],
          "priority": 2,
          "timeout": 30,
          "max_tokens": 4096,
          "alias": "gemini-flash",
          "_note": "付费Tier1：RPM=1K RPD=10K（截图实测），pro的fallback",
          "quotas": [
            {
              "metric": "requests",
              "window_seconds": 60,
              "limit": 1000,
              "_note": "Tier1 RPM 截图实测"
            },
            {
              "metric": "requests",
              "window_seconds": 86400,
              "limit": 10000,
              "_note": "Tier1 RPD 截图实测"
            },
            {
              "metric": "tokens",
              "window_seconds": 60,
              "limit": 2000000,
              "_note": "Tier1 TPM 截图实测"
            }
          ],
          "cooldown_seconds": 60
        },
        {
          "name": "gemini-3.5-flash-lite",
          "capabilities": [
            "general",
            "ocr"
          ],
          "priority": 3,
          "timeout": 20,
          "max_tokens": 2048,
          "alias": "gemini-lite",
