{
  "schema_version": "4.0",
  "capability_provider_whitelist": {
    "grounding": [
      "google",
      "alibailian"
    ],
    "ui-grounding": [
      "alibailian",
      "google",
      "google-free"
    ]
  },
  "roles": {
    "quick": {
      "system_prompt": null,
      "requires": [
        "general"
      ],
      "output_schema": "text",
      "skip_context": true,
      "preferred_models": [
        "gemini-flash-lite-free",
        "gemini-flash-lite-free-35",
        "qwen-flash",
        "qwen-vl-flash",
        "gemini-flash-lite"
      ],
      "_note": "免费浮动 lite 打头（0 成本），免费 pin 兜底，再廉价付费溢出"
    },
    "comprehensive": {
      "system_prompt": null,
      "requires": [
        "general"
      ],
      "output_schema": "text",
      "default": true,
      "system_prompt_file": "prompts/comprehensive.md",
      "preferred_models": [
        "gemini-flash",
        "qwen-max",
        "gemini-pro",
        "qwen-vl",
        "doubao-lite"
      ]
    },
    "ocr": {
      "system_prompt": null,
      "requires": [
        "ocr"
      ],
      "output_schema": "text",
      "system_prompt_file": "prompts/ocr.md",
      "preferred_models": [
        "gemini-pro",
        "gemini-flash",
        "qwen-vl",
        "qwen-vl-235b",
        "doubao-lite"
      ],
      "_note": "Gemini 原生 OCR 优先，qwen-vl 覆盖中文密集文本"
    },
    "code": {
      "system_prompt": null,
      "requires": [
        "general"
      ],
      "output_schema": "text",
      "system_prompt_file": "prompts/code.md",
      "preferred_models": [
        "gemini-flash",
        "qwen-plus",
        "qwen-max",
        "gemini-pro"
      ]
    },
    "compare": {
      "system_prompt": null,
      "requires": [
        "general"
      ],
      "multi_image": true,
      "output_schema": "text",
      "system_prompt_file": "prompts/compare.md",
      "preferred_models": [
        "gemini-pro",
        "gemini-flash",
        "qwen-max",
        "qwen-vl"
      ]
    },
    "locate": {
      "system_prompt": null,
      "requires": [
        "grounding"
      ],
      "output_schema": "bbox_list",
      "query_mode": "targeted",
      "system_prompt_file": "prompts/locate.md",
      "preferred_models": [
        "gemini-pro",
        "qwen-vl",
        "qwen-vl-235b"
      ],
      "_note": "仅 grounding 模型，无通用兜底；doubao-pro 待 verify-grounding 通过后再加入"
    },
    "locate-ui": {
      "system_prompt": null,
      "requires": [
        "ui-grounding"
      ],
      "output_schema": "bbox_list",
      "query_mode": "enumerate_then_filter",
      "system_prompt_file": "prompts/locate-ui.md",
      "preferred_models": [
        "qwen-vl",
        "gemini-flash",
        "qwen-vl-flash"
      ],
      "_note": "仅 ui-grounding 模型；doubao-lite 实测 grounding 不达标（IoU 0.33/0.0），不入池"
    },
    "promptify": {
      "system_prompt_file": "prompts/reverse-prompt.md",
      "requires": [
        "general"
      ],
      "output_schema": "text",
      "max_tokens": 8192,
      "preferred_models": [
        "gemini-flash",
        "gemini-pro",
        "qwen-max",
        "qwen-vl"
      ],
      "_note": "逆向提示词工程，max_tokens=8192 确保长 prompt 不被截断"
    }
  },
  "defaults": {
    "role": "comprehensive",
    "format": "json",
    "timeout": 300
  },
  "cache": {
    "enabled": false,
    "dir": "~/.cache/vision-engine",
    "ttl_hours": 24
  },
  "logging": {
    "enabled": true,
    "file": "~/.local/share/vision-engine/log.jsonl",
    "level": "info",
    "rotate_mb": 50,
    "rotate_keep": 3
  },
  "context": {
    "task_goal_max_chars": 120,
    "prior_context_max_items": 2
  },
  "providers": {
    "anthropic": {
      "base_url": "https://api.anthropic.com",
      "api_format": "anthropic",
      "api_key_env": "ANTHROPIC_API_KEY",
      "models": [
        {
          "name": "claude-sonnet-5",
          "capabilities": [
            "general",
            "ocr"
          ],
          "priority": 1,
          "timeout": 300,
          "max_tokens": 4096,
          "alias": "sonnet",
          "quotas": [
            {
              "metric": "requests",
              "window_seconds": 60,
              "limit": 60,
              "_note": "保守默认值，待实测"
            }
          ]
        }
      ]
    },
    "openai": {
      "base_url": "https://api.openai.com/v1",
      "api_format": "openai",
      "api_key_env": "OPENAI_API_KEY",
      "models": [
        {
          "name": "gpt-5.6-terra",
          "capabilities": [
            "general"
          ],
          "priority": 2,
          "timeout": 300,
          "max_tokens": 4096,
          "alias": "gpt-5.6",
          "quotas": [
            {
              "metric": "requests",
              "window_seconds": 60,
              "limit": 60,
              "_note": "保守默认值，待实测"
            }
          ]
        }
      ]
    },
