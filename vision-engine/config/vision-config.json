            },
            {
              "metric": "tokens",
              "window_seconds": 60,
              "limit": 4000000,
              "_note": "Tier1 TPM 截图实测"
            }
          ],
          "cooldown_seconds": 60
        },
        {
          "name": "gemini-3-flash-preview",
          "capabilities": [
            "general",
            "ocr"
          ],
          "priority": 2,
          "timeout": 30,
          "max_tokens": 4096,
          "alias": "gemini-flash-v3",
          "_note": "付费Tier1：RPM=1K TPM=2M RPD=10K（截图实测）",
          "quotas": [
            {
              "metric": "requests",
              "window_seconds": 60,
              "limit": 1000,
              "_note": "Tier1 RPM 截图实测"
            },
            {
              "metric": "requests",
              "window_seconds": 86400,
              "limit": 10000,
              "_note": "Tier1 RPD 截图实测"
            },
            {
              "metric": "tokens",
              "window_seconds": 60,
              "limit": 2000000,
              "_note": "Tier1 TPM 截图实测"
            }
          ],
          "cooldown_seconds": 60
        }
      ]
