{
  "schema_version": "4.0",
  "capability_provider_whitelist": {
    "grounding": [
      "google",
      "alibaba",
      "bytedance"
    ],
    "ui-grounding": [
      "self-hosted"
    ]
  },
  "roles": {
    "quick": {
      "system_prompt": null,
      "requires": [
        "general"
      ],
      "output_schema": "text",
      "skip_context": true
    },
    "comprehensive": {
      "system_prompt": null,
      "requires": [
        "general"
      ],
      "output_schema": "text",
      "default": true,
      "system_prompt_file": "prompts/comprehensive.md",
      "preferred_models": [
        "sonnet",
        "gpt"
      ]
    },
    "ocr": {
      "system_prompt": "你是 OCR 专家。提取图片中所有文字，保持原始排版。表格用 Markdown 表格输出。",
      "requires": [
        "ocr"
      ],
      "output_schema": "text"
    },
    "code": {
      "system_prompt": "你是代码截图识别专家。提取代码，保持缩进和语法。输出在代码块中，标注语言。",
      "requires": [
        "ocr"
      ],
      "output_schema": "text"
    },
    "compare": {
      "system_prompt": "你是 UI 对比专家。对比两张图片的差异，重点关注布局、颜色、元素位置变化。",
      "requires": [
        "general"
      ],
      "multi_image": true,
      "output_schema": "text"
    },
    "locate": {
      "system_prompt": null,
      "requires": [
        "grounding"
      ],
      "output_schema": "bbox_list",
      "query_mode": "targeted",
      "system_prompt_file": "prompts/locate.md"
    },
    "locate-ui": {
      "system_prompt": null,
      "requires": [
        "ui-grounding"
      ],
      "output_schema": "bbox_list",
      "query_mode": "enumerate_then_filter"
    }
  },
  "defaults": {
    "role": "comprehensive",
    "format": "json",
    "timeout": 60
  },
  "cache": {
    "enabled": false,
    "dir": "~/.cache/vision-engine",
    "ttl_hours": 24
  },
  "logging": {
    "enabled": true,
    "file": "~/.local/share/vision-engine/log.jsonl",
    "level": "info",
    "rotate_mb": 50,
    "rotate_keep": 3
  },
  "context": {
    "task_goal_max_chars": 120,
    "prior_context_max_items": 2
  },
  "providers": {
    "anthropic": {
      "base_url": "https://api.anthropic.com",
      "api_format": "anthropic",
      "api_key_env": "ANTHROPIC_API_KEY",
      "models": [
        {
          "name": "claude-sonnet-5",
          "capabilities": [
            "general",
            "ocr"
          ],
          "priority": 1,
          "timeout": 60,
          "max_tokens": 4096,
          "rpm_limit": 60,
          "alias": "sonnet"
        }
      ]
    },
    "openai": {
      "base_url": "https://api.openai.com/v1",
      "api_format": "openai",
      "api_key_env": "OPENAI_API_KEY",
      "models": [
        {
          "name": "gpt-5.6-terra",
          "capabilities": [
            "general",
            "ocr"
          ],
          "priority": 2,
          "timeout": 60,
          "max_tokens": 4096,
          "rpm_limit": 60,
          "alias": "gpt"
        }
      ]
    },
    "google": {
      "base_url": "https://generativelanguage.googleapis.com/v1beta",
      "api_format": "google",
      "api_key_env": "GOOGLE_API_KEY",
      "models": [
        {
          "name": "gemini-3-pro",
          "capabilities": [
            "general",
            "ocr",
            "grounding"
          ],
          "coordinate_convention": "gemini_1000",
          "priority": 1,
          "timeout": 60,
          "max_tokens": 4096,
          "rpm_limit": 60,
          "_note": "2026年7月存在gemini-3/3.1/3.5/3.6多个并行命名，接入前请对照Google AI实时model list核实此ID",
          "alias": "gemini"
        }
      ]
    },
    "alibaba": {
      "base_url": "https://dashscope-intl.aliyuncs.com/compatible-mode/v1",
      "api_format": "openai",
      "api_key_env": "DASHSCOPE_API_KEY",
      "models": [
        {
          "name": "qwen3-vl-plus",
          "capabilities": [
            "general",
            "ocr",
            "grounding"
          ],
          "coordinate_convention": "qwen_pixel",
          "priority": 2,
          "timeout": 60,
          "max_tokens": 4096,
          "rpm_limit": 30,
          "_note": "国内账号改用 https://dashscope.aliyuncs.com/compatible-mode/v1",
          "alias": "qwen"
        }
      ]
    },
    "bytedance": {
      "base_url": "https://openrouter.ai/api/v1",
      "api_format": "openai",
      "api_key_env": "OPENROUTER_API_KEY",
      "models": [
        {
          "name": "ui-tars-1.5-7b",
          "capabilities": [
            "grounding"
          ],
          "coordinate_convention": "qwen_pixel",
          "priority": 3,
          "timeout": 60,
          "max_tokens": 2048,
          "rpm_limit": 60,
          "_note": "云端托管，无需自部署；坐标约定假设为像素坐标，接入后需用--verify-grounding实测确认",
          "alias": "uitars"
        }
      ]
    },
    "self-hosted": {
      "base_url": "http://127.0.0.1:8765",
      "api_format": "omniparser",
      "api_key_env": null,
      "models": [
        {
          "name": "omniparser-local",
          "capabilities": [
            "ui-grounding"
          ],
          "coordinate_convention": "omniparser_pixel",
          "priority": 1,
          "timeout": 30,
          "max_tokens": null,
          "rpm_limit": 120,
          "_note": "可选。仅在需要枚举画面全部UI元素时才需要自部署，不需要这个能力可以不配",
          "alias": "omniparser"
        }
      ]
    },
    "minimax": {
      "base_url": "https://api.minimax.io/anthropic",
      "api_format": "anthropic",
      "api_key_env": "MINIMAX_API_KEY",
      "models": [
        {
          "name": "MiniMax-M3",
          "capabilities": [
            "general"
          ],
          "priority": 3,
          "timeout": 60,
          "max_tokens": 2048,
          "rpm_limit": 30,
          "_note": "base_url已从api.minimaxi.com更正为api.minimax.io（前者是历史/国内域名）",
          "alias": "minimax"
        }
      ]
    }
  }
}